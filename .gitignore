# Secrets & local config — never commit
.env
# Local compose override (podman-built image tag; see file header)
docker-compose.override.yml
.ssh/*
!.ssh/.gitkeep

# Editor
.vscode/

# Runtime state (keep the dirs, drop the contents)
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep

# Bundled DB host bind mounts (Neo4j / PostgreSQL / Redis data + logs)
neo4j_data/
postgres_data/
postgres_logs/
redis_data/

# Local SILVAENGINE_SRC staging dir (containers mount it at /app/src; keep dir)
silvaengine/*
!silvaengine/.gitkeep

# Misc
*.bak
__pycache__/
*.pyc

.dockerignore
.claude
