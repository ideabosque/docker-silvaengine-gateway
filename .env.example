# =============================================================================
# SilvaEngine Gateway — container environment (TEMPLATE)
# =============================================================================
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored; this template is committed. NEVER put real secrets here.
#
# docker-compose reads CONTAINER_PORT / GATEWAY_PORT / COMPOSE_PROFILES / the
# *_VERSION/*_HOST_DIR service vars; the rest is fed to the gateway, which
# forwards module settings to each engine's Config.initialize(). Each backing
# store (Postgres / Neo4j / Redis) has ONE section below holding both its
# connection vars and its optional bundled-service vars.
# =============================================================================

# ── Engine source mount + PYTHONPATH ─────────────────────────────────────────
# Host path to the source repos. Engine modules are NOT installed in the image —
# they run from this read-only mount (/app/src). PYTHONPATH lists the repo roots
# that are importable (ai_agent_core_engine loads agent handlers dynamically, so
# those must be on the path too). Edit locally + restart, no rebuild.
SILVAENGINE_SRC=../
PYTHONPATH=/app/src/silvaengine/knowledge_graph_engine:/app/src/silvaengine/rfq_engine:/app/src/silvaengine/ai_marketing_engine:/app/src/silvaengine/mcp_daemon_engine:/app/src/silvaengine/ai_agent_core_engine:/app/src/silvaengine/ai_agent_handler:/app/src/silvaengine/openai_completions_agent_handler:/app/src/silvaengine/ai_coordination_engine:/app/src/silvaengine/client_engine:/app/src/silvaengine/setting_core_engine:/app/src/silvaengine/a2a_daemon_engine

# ── Server / ports ───────────────────────────────────────────────────────────
# GATEWAY_PORT is the in-container bind port; if MCP tool packages call back into
# the gateway it MUST match the gateway_base_url they were deployed with.
CONTAINER_PORT=8765                  # host port published by docker-compose
GATEWAY_PORT=8765                    # in-container uvicorn bind port
GATEWAY_HOST=0.0.0.0
GATEWAY_WORKERS=1                    # >1 requires shared task/rate/SSE backends
GATEWAY_DISPATCH_WORKERS=32          # dispatch thread-pool size
# CORS: "*" (or unset) = any origin WITHOUT credentials; CSV of origins to also
# allow credentials/cookies (wildcard + credentials are mutually exclusive).
GATEWAY_CORS_ORIGINS=*

# ── Auth ─────────────────────────────────────────────────────────────────────
GATEWAY_AUTH_PROVIDER=local          # local | cognito
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP=15                  # token lifetime (minutes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# ADMIN_STATIC_TOKEN=                 # optional pre-minted permanent admin token
# LOCAL_USER_FILE=/app/data/users.json   # drop users.json into ./data to use
# Cognito (only when GATEWAY_AUTH_PROVIDER=cognito):
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=
# COGNITO_APP_SECRET=
# COGNITO_JWKS_URL=

# ── Route manifest ───────────────────────────────────────────────────────────
# Custom manifest mounted at ./data/routes.yaml. If set but missing, the gateway
# falls back to the built-in KGE-only default — keep the mount.
GATEWAY_ROUTES_CONFIG_PATH=/app/data/routes.yaml

# ── Shared-store backends (required when GATEWAY_WORKERS > 1) ─────────────────
GATEWAY_TASK_BACKEND=memory          # memory | dynamodb
GATEWAY_TASK_TTL=3600
GATEWAY_RATE_LIMIT_BACKEND=memory    # memory | dynamodb
GATEWAY_RATE_LIMIT=500
GATEWAY_RATE_WINDOW=60

# ── Tenant ───────────────────────────────────────────────────────────────────
# endpoint_id=gpt
# part_id=nestaging

# ── AWS / DynamoDB ───────────────────────────────────────────────────────────
# Shared across modules (also needed for S3 file parsing even on the PG backend).
# Lowercase = SilvaEngine setting-dict convention.
initialize_tables=1
region_name=us-west-2
aws_access_key_id=
aws_secret_access_key=

# ── Bundled services (compose profiles) ──────────────────────────────────────
# Neo4j / PostgreSQL / Redis can run as compose services instead of external
# ones. Each starts ONLY when its profile is listed here. Empty = all external
# (point the connection vars below at host.docker.internal). When you enable a
# profile, set the matching connection host to the service name:
#   postgres -> PG_HOST=postgres   |   neo4j -> neo4j_uri=bolt://neo4j:7687
#   redis    -> REDIS_HOST=redis (+ cache_enabled=1)
COMPOSE_PROFILES=

# ── PostgreSQL (dual-backend metadata store) ─────────────────────────────────
db_backend=postgresql                # dynamodb | postgresql
# Connection (used when db_backend=postgresql). PG_HOST = host.docker.internal
# (external) or 'postgres' (bundled service). localhost inside a container refers
# to the container itself, not the host.
PG_HOST=host.docker.internal
PG_PORT=5432
PG_USER=silvaengine
PG_PASSWORD=silvaengine
PG_DB=silvaengine
# DATABASE_URL=                       # overrides PG_* (migrations/alembic) if set
# Per-module table prefixes (avoid collisions in a shared database):
KGE_PG_TABLE_PREFIX=kge_
RFQ_PG_TABLE_PREFIX=rfq_
AME_PG_TABLE_PREFIX=ame_
ACE_PG_TABLE_PREFIX=ace_
AACE_PG_TABLE_PREFIX=aace_
CE_PG_TABLE_PREFIX=ce_
SCE_PG_TABLE_PREFIX=sce_
# Bundled service settings (profile: postgres). Credentials/port reuse the PG_*
# vars above (single source of truth) — only image/name/paths/logging here.
POSTGRES_VERSION=17-alpine
POSTGRES_CONTAINER_NAME=silvaengine-postgres
POSTGRES_DATA_PATH=./postgres_data   # host dir for the PG data directory
POSTGRES_LOG_PATH=./postgres_logs    # host dir for PG log files
LOG_STATEMENT=none                   # none | ddl | mod | all
LOG_MIN_DURATION=1000                # log queries slower than N ms (-1 disables)

# ── Neo4j (Knowledge Graph Engine graph store; always required) ──────────────
# Connection: neo4j_uri = bolt://host.docker.internal:7687 (external) or
# bolt://neo4j:7687 (bundled).
neo4j_uri=bolt://host.docker.internal:7687
neo4j_username=neo4j
neo4j_password=change-me
neo4j_database=neo4j
# Bundled service settings (profile: neo4j). NEO4J_AUTH must match user/password.
NEO4J_VERSION=5-community
NEO4J_CONTAINER_NAME=silvaengine-neo4j
NEO4J_AUTH=neo4j/change-me
NEO4J_BROWSER_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HOST_DIR=./neo4j_data          # host dir for data/logs/import/plugins

# ── Redis / cache ────────────────────────────────────────────────────────────
# The cache layer (silvaengine_utility HybridCacheEngine) uses Redis as primary
# with disk fallback, reading these DIRECTLY from the environment. Redis is used
# only when cache_enabled=1 AND REDIS_HOST is set; otherwise disk-only.
cache_enabled=0
# Connection — REDIS_HOST = 'redis' (bundled) or host.docker.internal (external):
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=                     # must match the redis service's requirepass
# REDIS_DB_<CACHE_NAME>=1             # optional per-cache DB override (name uppercased)
# Bundled service settings (profile: redis). Empty REDIS_PASSWORD = no auth.
REDIS_VERSION=7-alpine
REDIS_CONTAINER_NAME=silvaengine-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATA_PATH=./redis_data         # host dir for Redis AOF/RDB persistence

# ── LLM ──────────────────────────────────────────────────────────────────────
llm_type=openai
llm_name=gpt-4o
openai_api_key=
# anthropic_api_key=
embedding_model=text-embedding-3-small
# Agent cache pre-warming: CSV of agent UUIDs to pre-warm at startup (empty = all).
# PREWARM_AGENT_UUIDS=agent-1780802783-70468776

# ── MCP Daemon Engine ────────────────────────────────────────────────────────
MCP_TRANSPORT=sse                    # served over HTTP/SSE inside FastAPI
FUNCT_BUCKET_NAME=                   # S3 bucket for MCP tool packages
FUNCT_ZIP_PATH=/app/data/funct_zips  # local zip staging (under mounted ./data)
FUNCT_EXTRACT_PATH=/app/data/functs  # package extraction (must be importable)

# ── Internal MCP (ai_agent_core_engine) ──────────────────────────────────────
# Forwarded as `internal_mcp`. REQUIRED if any agent's mcp_server_uuids reference
# the internal MCP (else ask_model fails with "Internal MCP (None) is not
# configured correctly").
#   internal_mcp_base_url : HOST ONLY of this gateway (loopback in-container);
#                           it appends /{endpoint_id}/mcp itself. Match GATEWAY_PORT.
#   bearer_token          : used directly if set; otherwise the gateway mints a
#                           local JWT from internal_mcp_token_username/password.
#   x-api-key             : header sent on internal MCP calls.
# internal_mcp_base_url=http://localhost:8765
# internal_mcp_bearer_token=
# internal_mcp_token_username=admin
# internal_mcp_token_password=change-me
# x-api-key=

# ── A2A / Hermes bridge (a2a_daemon_engine) ──────────────────────────────────
# Forwarded to a2a_daemon_engine so the bridge can route A2A tasks to a Hermes
# Agent API Server via HTTP + SSE. Config resolution priority:
#   1. Agent metadata (DB) — per-agent routing   2. Setting dict   3. env below
# The env vars are global fallbacks only (apply when the agent record has no
# metadata). Prereqs: Hermes API Server running; a2a_daemon_engine on PYTHONPATH;
# hermes-agent registered in the DB with module_name/class_name/hermes_* metadata.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=                        # Bearer token for Hermes API Server
HERMES_MODEL=hermes-agent
HERMES_STREAM_TIMEOUT=300               # SSE stream timeout (seconds)
# A2A handler resolution is metadata-only: module_name / class_name come from
# each agent's a2a_agents DB record. A2A_DEFAULT_AGENT_UUID names which agent to
# use when a request omits agent_uuid.
A2A_DEFAULT_AGENT_UUID=a2a-default-agent
A2A_STREAM_TIMEOUT=120.0
A2A_STREAMING_ENABLED=true
